generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AsalUnit {
  KSR_MARKAS
  KSR_UNSUR
  KSR_UNPI
}

enum Divisi {
  KOMANDAN
  KETUA_PELAKSANA
  WAKIL_KETUA
  BENDAHARA
  WAKIL_BENDAHARA_1
  WAKIL_BENDAHARA_2
  SEKRETARIS
  WAKIL_SEKRETARIS
  KESEKRETARIATAN
  ACARA
  HUMAS_DAN_DOKUMENTASI
  GIAT
  KEAMANAN_DAN_EVAKUASI
  SANITASI
  TRANSPORTASI
  PERKEMAHAN
  DAPUR_UMUM
  PERALATAN
  YANKES
}

enum StatusPanitia {
  TERDAFTAR
  HADIR
}

enum AdminRole {
  SUPERADMIN
  KESEKRETARIATAN
  KEUANGAN
  ACARA
  KTA
}

model Panitia {
  id              String        @id @default(cuid())
  nomorRegistrasi String        @unique
  nama            String
  gender          Gender
  noWhatsapp      String
  alamat          String        @db.Text
  asalUnit        AsalUnit
  divisi          Divisi

  fotoUrl         String        @db.Text
  qrCodeUrl       String?       @db.Text
  idCardUrl       String?       @db.Text
  qrToken         String        @unique

  status          StatusPanitia @default(TERDAFTAR)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  absensiLogs AbsensiLog[]

  @@map("panitia")
}

model Admin {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  nama         String
  role         AdminRole   @default(SUPERADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  adminLogs    AdminLog[]  // <--- TAMBAHKAN INI (Relasi balikan)

  @@map("admin")
}

model AbsensiSesi {
  id         String   @id @default(cuid())
  nama       String
  tanggal    DateTime @db.Date
  jamMulai   String   // format "HH:mm", contoh: "07:00"
  jamSelesai String   // format "HH:mm", contoh: "09:00"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs AbsensiLog[]

  @@map("absensi_sesi")
}

model AbsensiLog {
  id        String   @id @default(cuid())
  panitiaId String
  sesiId    String
  scannedAt DateTime @default(now())

  panitia Panitia     @relation(fields: [panitiaId], references: [id], onDelete: Cascade)
  sesi    AbsensiSesi @relation(fields: [sesiId], references: [id], onDelete: Cascade)

  @@unique([panitiaId, sesiId])
  @@map("absensi_log")
}

enum Jenjang {
  SMP
  MTS
  SMA
  SMK
  MA
}

enum StatusSekolah {
  NEGERI
  SWASTA
}

enum KategoriSekolah {
  WIRA
  MADYA
}

enum TipePeserta {
  PESERTA
  PENDAMPING
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
  LAINNYA
}

enum GolonganDarah {
  A
  B
  AB
  O
  TIDAK_TAHU
}


model Sekolah {
  id                String   @id @default(cuid())

  jenjang           Jenjang
  statusSekolah     StatusSekolah
  namaInput         String
  namaLengkap       String   @unique
  kategori          KategoriSekolah

  nomorPendaftaran  Int
  tahunPendaftaran  Int
  kodePendaftaran   String   @unique

  namaPembina       String
  noWhatsappPembina String

  estimasiPesertaPendamping Int?

excelUrl          String?  @db.Text
  suratPernyataanUrl String? @db.Text
  tandaTanganPenanggungJawabUrl String? @db.Text
  termsVersion     String?
  termsAgreedAt    DateTime?
  sudahCetak       Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  peserta           Peserta[]
  tendaSewa         TendaSewa[]
  pembayaran        Pembayaran[]

  @@map("sekolah")
}

model Peserta {
  id                  String   @id @default(cuid())
  sekolahId           String
  tipe                TipePeserta

  batchKe             Int      @default(1)

  noPeserta           String?  @unique

  namaLengkap         String
  tempatLahir         String
  tanggalLahir        DateTime @db.Date
  alamat              String   @db.Text
  agama               Agama
  golonganDarah       GolonganDarah
  tahunMasuk          Int
  noHp                String?
  gender              Gender

  riwayatPenyakit     RiwayatPenyakit?

  fotoUrl             String?  @db.Text

  createdAt           DateTime @default(now())

  sekolah             Sekolah  @relation(fields: [sekolahId], references: [id], onDelete: Cascade)

  @@map("peserta")
}
model TendaJenis {
  id           String   @id @default(cuid())
  nama         String
  namaVendor   String?
  kapasitasMin Int
  kapasitasMax Int
  harga        Int
  hargaVendor  Int      @default(0)
  stokTotal    Int

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tendaSewa    TendaSewa[]
  reservasiItems ReservasiTendaItem[]

  @@map("tenda_jenis")
}

model TendaSewa {
  id                  String   @id @default(cuid())
  sekolahId           String
  tendaJenisId        String
  jumlah              Int
  hargaSatuanSaatSewa Int // snapshot harga saat disewa, jaga-jaga kalau harga berubah nanti

  createdAt           DateTime @default(now())

  sekolah             Sekolah    @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  tendaJenis           TendaJenis @relation(fields: [tendaJenisId], references: [id])

  @@map("tenda_sewa")
}

enum TipePembayaran {
  PESERTA
  TENDA
}

enum StatusPembayaran {
  BELUM_BAYAR
  MENUNGGU_KONFIRMASI
  LUNAS
  DITOLAK
}

model Pembayaran {
  id                String           @id @default(cuid())
  sekolahId         String
  tipe              TipePembayaran

  batchKe           Int              @default(1)

  jumlahBiaya       Int
  statusPembayaran  StatusPembayaran @default(BELUM_BAYAR)

  buktiTransferUrl  String?          @db.Text
  catatanAdmin      String?          @db.Text

  kwitansiUrl       String?          @db.Text
  qrToken           String?          @unique

  statusDaftarUlang Boolean          @default(false)
  waktuDaftarUlang  DateTime?

  dibayarPada       DateTime?
  dikonfirmasiPada  DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  sekolah           Sekolah          @relation(fields: [sekolahId], references: [id], onDelete: Cascade)

  @@unique([sekolahId, tipe, batchKe])
  @@map("pembayaran")
}

enum JenisTransaksi {
  PEMASUKAN
  PENGELUARAN
  UTANG
}

enum KategoriPemasukan {
  PENDAFTARAN
  SEWA_TENDA
  SPONSOR
  PERSENTASE_TENDA
}

enum KategoriPengeluaran {
  SETOR_TENDA
  OPERASIONAL_DIVISI
  BEBAN_PENGELUARAN
}

model TransaksiKeuangan {
  id                  String   @id @default(cuid())
  tanggal             DateTime @db.Date
  keterangan          String   @db.Text
  jenis               JenisTransaksi

  kategoriPemasukan   KategoriPemasukan?
  kategoriPengeluaran KategoriPengeluaran?

  debit               Int      @default(0)
  kredit               Int      @default(0)
  utang               Int      @default(0)

  divisi              Divisi?
  pic                 String?

  pengajuanId         String?  @unique
  pengajuan           PengajuanAnggaran? @relation(fields: [pengajuanId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("transaksi_keuangan")
}
enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

model PengajuanAnggaran {
  id               String   @id @default(cuid())
  nomorPengajuan   String   @unique

  namaKoordinator  String
  divisi           Divisi
  noHp             String

  totalJenisBarang Int
  totalKuantitas   Int
  totalPengajuan   Int

  tandaTanganUrl   String?  @db.Text
  pdfUrl           String?  @db.Text

  status           StatusPengajuan @default(MENUNGGU)
  catatanAdmin     String?  @db.Text
  diprosesPada     DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            PengajuanItem[]
  transaksi        TransaksiKeuangan?

  @@map("pengajuan_anggaran")
}

model PengajuanItem {
  id           String   @id @default(cuid())
  pengajuanId  String
  namaBarang   String
  qty          Int
  hargaSatuan  Int
  total        Int

  pengajuan    PengajuanAnggaran @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)

  @@map("pengajuan_item")
}

enum RiwayatPenyakit {
  TIDAK_ADA
  ASMA_BERAT
  EPILEPSI
  JANTUNG
  DIABETES
  HIPERTENSI_BERAT
  GANGGUAN_GINJAL
  GANGGUAN_PERNAPASAN_KRONIS
  RIWAYAT_KEJANG
  HEMOFILIA
  ANEMIA_BERAT
  LAINNYA
}

model AdminLog {
  id           String      @id @default(cuid())
  adminId      String?
  adminName    String
  adminRole    AdminRole?
  action       String
  targetType   String?
  targetId     String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime    @default(now())
  admin        Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("admin_log")
}

model ReservasiTenda {
  id                String   @id
  namaSekolah       String
  kategori          KategoriSekolah
  namaPembina       String
  noWhatsappPembina String
  estimasiPesertaPendamping Int
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ReservasiTendaItem[]

  @@index([expiresAt])
  @@map("reservasi_tenda")
}

model ReservasiTendaItem {
  id             String @id @default(cuid())
  reservasiId    String
  tendaJenisId   String
  jumlah         Int
  hargaSatuan    Int

  reservasi      ReservasiTenda @relation(fields: [reservasiId], references: [id], onDelete: Cascade)
  tendaJenis     TendaJenis     @relation(fields: [tendaJenisId], references: [id])

  @@unique([reservasiId, tendaJenisId])
  @@map("reservasi_tenda_item")
}
