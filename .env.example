# Production runtime
NODE_ENV=production
DATABASE_URL="mysql://pmi_app:PASSWORD_DATABASE@127.0.0.1:3306/pmi_event"
NEXT_PUBLIC_BASE_URL="https://pmi-cianjur.com"

# Authentication secrets. Generate with: openssl rand -base64 32
JWT_SECRET="GANTI_DENGAN_SECRET_ACAK_PANJANG"
SUSULAN_JWT_SECRET="GANTI_DENGAN_SECRET_ACAK_LAIN"
CRON_SECRET="GANTI_DENGAN_SECRET_CRON"

# Initial accounts used only by `npx prisma db seed` when they do not exist.
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"
KTA_INITIAL_USERNAME=""
KTA_INITIAL_PASSWORD=""

# Optional WhatsApp Meta integration
WA_SENDER_NUMBER=""
WA_META_TOKEN=""
WA_META_PHONE_NUMBER_ID=""
WA_META_USE_TEMPLATE="false"
WA_TEMPLATE_DISETUJUI="pengajuan_disetujui"
WA_TEMPLATE_DITOLAK="pengajuan_ditolak"
